# Copy to `.env` and fill in values. Never commit `.env`.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: web auth redirect (defaults work for native)
# EXPO_PUBLIC_SUPABASE_REDIRECT_URL=http://localhost:8081/auth/callback

# RevenueCat public SDK key (iOS) — from RevenueCat dashboard → Project → API keys
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_ios_public_key_here

# Android (when shipping Play Store builds)
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_android_public_key_here

# Optional: error monitoring
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
