{
  "name": "iron-path-app",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "android": "expo run:android",
    "android:dev": "expo run:android",
    "ios": "expo run:ios",
    "ios:dev": "expo run:ios",
    "ios:device": "expo run:ios --device 'iPhone 17 Pro Max'",
    "ios:simulator": "xcrun simctl boot 'iPhone 17 Pro Max' 2>/dev/null || true && open -a Simulator",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "prebuild:all": "expo prebuild --clean",
    "lint": "tsc --noEmit",
    "lint:eslint": "expo lint",
    "test": "vitest run",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "eas": "npx eas-cli@latest",
    "eas:dev:ios": "npx eas-cli@latest build --profile development --platform ios",
    "eas:dev:android": "npx eas-cli@latest build --profile development --platform android"
  },
  "dependencies": {
    "@bacons/apple-targets": "^4.0.7",
    "@kingstinct/react-native-healthkit": "^13.1.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.5.1",
    "@react-native-community/slider": "^5.1.1",
    "@react-native-picker/picker": "2.11.1",
    "@sentry/react-native": "^8.11.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.84.0",
    "babel-preset-expo": "~54.0.0",
    "expo": "~54.0.25",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "^55.0.14",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.15",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.19",
    "expo-video": "~3.0.16",
    "lucide-react-native": "^0.554.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-body-highlighter": "^3.1.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-nitro-modules": "^0.32.0",
    "react-native-purchases": "^8.12.0",
    "react-native-purchases-ui": "^8.12.0",
    "react-native-reanimated": "4.1.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.6.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "nativewind": "^2.0.11",
    "patch-package": "^8.0.1",
    "react-native-css-interop": "^0.2.1",
    "tailwindcss": "3.3.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  },
  "private": true
}
